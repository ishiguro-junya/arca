[project]
name = "demo-backend"
version = "0.1.0"
requires-python = ">=1.2"
dependencies = ["alembic", "fastapi[standard]", "httpx", "sqlalchemy"]

[dependency-groups]
dev = ["pytest", "ruff", "vulture"]

[tool.pytest.ini_options]
pythonpath = ["src"]

