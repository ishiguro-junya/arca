=== mise.toml 0644 ===
[settings]
lockfile = false

[tools]
"cocogitto" = "1.2.3"
"lefthook" = "1.2.3"
"lychee" = "1.2.3"
"node" = "1.2.3"
"osv-scanner" = "1.2.3"
"pnpm" = "1.2.3"
"python" = "1.2.3"
"semgrep" = "1.2.3"
"terraform" = "1.2.3"
"tflint" = "1.2.3"
"trivy" = "1.2.3"
"trufflehog" = "1.2.3"
"uv" = "1.2.3"

[tasks."setup"]
description = "依存関係をインストールする"
run = '''
set -e
pnpm install --frozen-lockfile
uv sync --project backend --frozen
terraform -chdir=infra init -backend=false
if [ -e .git ]; then lefthook install; fi
'''

[tasks."fmt"]
description = "コードを整形する"
run = '''
set -e
pnpm exec oxfmt --write .
uv run --project backend ruff format backend
terraform -chdir=infra fmt
'''

[tasks."fmt-check"]
description = "コードが整形済みか確認する"
run = '''
set -e
pnpm exec oxfmt --check .
uv run --project backend ruff format --check backend
terraform -chdir=infra fmt -check
'''

[tasks."lint"]
description = "静的解析を実行する"
run = '''
set -e
pnpm exec textlint "**/*.md"
pnpm exec markdownlint-cli2
lychee --exclude-path node_modules --exclude-path dist --exclude-path .cache .
pnpm exec oxlint .
pnpm exec knip
uv run --project backend ruff check backend
uv run --project backend vulture backend
terraform -chdir=infra validate
tflint --chdir=infra
'''

[tasks."typecheck"]
description = "型を検査する"
run = '''
set -e
pnpm exec tsc --noEmit -p tsconfig.json
pnpm exec tsc --noEmit -p tsconfig.cli.json
uv run --project backend python -m compileall -q backend/src
'''

[tasks."test"]
description = "テストを実行する"
run = '''
set -e
uv run --project backend pytest backend
'''

[tasks."security"]
description = "セキュリティ検査を実行する"
run = '''
set -e
osv-scanner scan source -r .
trufflehog filesystem . --fail --no-update
semgrep scan --config auto .
trivy config infra
'''

[tasks."build"]
description = "成果物をビルドする"
run = '''
set -e
pnpm exec next build
pnpm exec tsc -p tsconfig.cli.json
'''

[tasks."commit-check"]
description = "コミットメッセージを検査する"
run = '''
set -e
cog verify --file "$1"
'''

[tasks.check]
description = "全検査を実行する"
depends = ["fmt-check", "lint", "typecheck", "test", "security"]

[tasks."app:dev"]
description = "Appを起動する"
run = '''
set -e
pnpm exec next dev
'''

[tasks."app:build"]
description = "Appをビルドする"
run = '''
set -e
pnpm exec next build
'''

[tasks."backend:dev"]
description = "Backendを起動する"
run = '''
set -e
uv run --project backend fastapi dev backend/src/demo/main.py
'''

[tasks."backend:test"]
description = "Backendをテストする"
run = '''
set -e
uv run --project backend pytest backend
'''

[tasks."cli:dev"]
description = "CLIを実行する"
run = '''
set -e
pnpm exec tsx cli/main.ts
'''

[tasks."cli:build"]
description = "CLIをビルドする"
run = '''
set -e
pnpm exec tsc -p tsconfig.cli.json
'''

[tasks."infra:validate"]
description = "Infraを検証する"
run = '''
set -e
terraform -chdir=infra validate
tflint --chdir=infra
trivy config infra
'''

