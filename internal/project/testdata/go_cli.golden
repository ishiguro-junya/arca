=== AGENTS.md 0644 ===
# AIエージェント向けガイドライン

- mise.tomlで定義したツールとタスクを使用してください。
- package.jsonへscriptsを追加しないでください。
- 依存関係は各パッケージ管理ツールで固定してください。
- 変更完了前にmise run checkを実行してください。

=== README.md 0644 ===
# demo

Arcaで生成したプロジェクトです。

## 選択内容

- 用途: CLI
- CLI: Go

## miseタスク

- setup
- fmt
- fmt-check
- lint
- typecheck
- test
- security
- check
- build
- commit-check
- cli:dev
- cli:build

`mise run <task>`でタスクを実行します。

=== cli/main.go 0644 ===
package main

import (
    "fmt"
    "os"

    "github.com/spf13/cobra"
)

func main() {
    cmd := &cobra.Command{Use: "demo", Short: "demo command line interface"}
    if err := cmd.Execute(); err != nil {
        fmt.Fprintln(os.Stderr, err)
        os.Exit(1)
    }
}

=== go.mod 0644 ===
module github.com/example/demo

go 1.2

=== lefthook.yml 0644 ===
commit-msg:
  commands:
    conventional:
      run: mise run commit-check -- {1}

pre-commit:
  commands:
    fmt:
      run: mise run fmt-check
    lint:
      run: mise run lint

pre-push:
  commands:
    test:
      run: mise run test

=== mise.toml 0644 ===
[settings]
lockfile = false

[tools]
"cocogitto" = "1.2.3"
"go" = "1.2.3"
"lefthook" = "1.2.3"
"lychee" = "1.2.3"
"node" = "1.2.3"
"osv-scanner" = "1.2.3"
"pnpm" = "1.2.3"
"semgrep" = "1.2.3"
"trufflehog" = "1.2.3"

[tasks."setup"]
description = "依存関係をインストールする"
run = '''
set -e
pnpm install --frozen-lockfile
go mod download
if [ -e .git ]; then lefthook install; fi
'''

[tasks."fmt"]
description = "コードを整形する"
run = '''
set -e
gofmt -w cli
'''

[tasks."fmt-check"]
description = "コードが整形済みか確認する"
run = '''
set -e
test -z "$(gofmt -l cli)"
'''

[tasks."lint"]
description = "静的解析を実行する"
run = '''
set -e
pnpm exec textlint "**/*.md"
pnpm exec markdownlint-cli2
lychee --exclude-path node_modules --exclude-path dist --exclude-path .cache .
go vet ./...
'''

[tasks."typecheck"]
description = "型を検査する"
run = '''
set -e
echo "typecheckの対象はありません"
'''

[tasks."test"]
description = "テストを実行する"
run = '''
set -e
go test ./...
'''

[tasks."security"]
description = "セキュリティ検査を実行する"
run = '''
set -e
osv-scanner scan source -r .
trufflehog filesystem . --fail --no-update
semgrep scan --config auto .
'''

[tasks."build"]
description = "成果物をビルドする"
run = '''
set -e
go build -o dist/demo ./cli
'''

[tasks."commit-check"]
description = "コミットメッセージを検査する"
run = '''
set -e
cog verify --file "$1"
'''

[tasks.check]
description = "全検査を実行する"
depends = ["fmt-check", "lint", "typecheck", "test", "security"]

[tasks."cli:dev"]
description = "CLIを実行する"
run = '''
set -e
go run ./cli
'''

[tasks."cli:build"]
description = "CLIをビルドする"
run = '''
set -e
go build -o dist/demo ./cli
'''

