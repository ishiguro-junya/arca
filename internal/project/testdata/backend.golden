=== AGENTS.md 0644 ===
# AIエージェント向けガイドライン

- mise.tomlで定義したツールとタスクを使用してください。
- package.jsonへscriptsを追加しないでください。
- 依存関係は各パッケージ管理ツールで固定してください。
- 変更完了前にmise run checkを実行してください。

=== README.md 0644 ===
# demo

Arcaで生成したプロジェクトです。

## 選択内容

- 用途: Backend

## miseタスク

- setup
- fmt
- fmt-check
- lint
- typecheck
- test
- security
- check
- build
- commit-check
- backend:dev
- backend:test

`mise run <task>`でタスクを実行します。

=== backend/pyproject.toml 0644 ===
[project]
name = "demo-backend"
version = "0.1.0"
requires-python = ">=1.2"
dependencies = ["fastapi[standard]", "httpx"]

[dependency-groups]
dev = ["pytest", "ruff", "vulture"]

[tool.pytest.ini_options]
pythonpath = ["src"]

=== backend/src/demo/__init__.py 0644 ===


=== backend/src/demo/main.py 0644 ===
from fastapi import FastAPI

app = FastAPI()


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok"}

=== backend/tests/test_health.py 0644 ===
from fastapi.testclient import TestClient

from demo.main import app


def test_health() -> None:
    response = TestClient(app).get("/health")
    assert response.status_code == 200
    assert response.json() == {"status": "ok"}

=== lefthook.yml 0644 ===
commit-msg:
  commands:
    conventional:
      run: mise run commit-check -- {1}

pre-commit:
  commands:
    fmt:
      run: mise run fmt-check
    lint:
      run: mise run lint

pre-push:
  commands:
    test:
      run: mise run test

=== mise.toml 0644 ===
[settings]
lockfile = false

[tools]
"cocogitto" = "1.2.3"
"lefthook" = "1.2.3"
"lychee" = "1.2.3"
"node" = "1.2.3"
"osv-scanner" = "1.2.3"
"pnpm" = "1.2.3"
"python" = "1.2.3"
"semgrep" = "1.2.3"
"trufflehog" = "1.2.3"
"uv" = "1.2.3"

[tasks."setup"]
description = "依存関係をインストールする"
run = '''
set -e
pnpm install --frozen-lockfile
uv sync --project backend --frozen
if [ -e .git ]; then lefthook install; fi
'''

[tasks."fmt"]
description = "コードを整形する"
run = '''
set -e
uv run --project backend ruff format backend
'''

[tasks."fmt-check"]
description = "コードが整形済みか確認する"
run = '''
set -e
uv run --project backend ruff format --check backend
'''

[tasks."lint"]
description = "静的解析を実行する"
run = '''
set -e
pnpm exec textlint "**/*.md"
pnpm exec markdownlint-cli2
lychee --exclude-path node_modules --exclude-path dist --exclude-path .cache .
uv run --project backend ruff check backend
uv run --project backend vulture backend
'''

[tasks."typecheck"]
description = "型を検査する"
run = '''
set -e
uv run --project backend python -m compileall -q backend/src
'''

[tasks."test"]
description = "テストを実行する"
run = '''
set -e
uv run --project backend pytest backend
'''

[tasks."security"]
description = "セキュリティ検査を実行する"
run = '''
set -e
osv-scanner scan source -r .
trufflehog filesystem . --fail --no-update
semgrep scan --config auto .
'''

[tasks."build"]
description = "成果物をビルドする"
run = '''
set -e
echo "buildの対象はありません"
'''

[tasks."commit-check"]
description = "コミットメッセージを検査する"
run = '''
set -e
cog verify --file "$1"
'''

[tasks.check]
description = "全検査を実行する"
depends = ["fmt-check", "lint", "typecheck", "test", "security"]

[tasks."backend:dev"]
description = "Backendを起動する"
run = '''
set -e
uv run --project backend fastapi dev backend/src/demo/main.py
'''

[tasks."backend:test"]
description = "Backendをテストする"
run = '''
set -e
uv run --project backend pytest backend
'''

