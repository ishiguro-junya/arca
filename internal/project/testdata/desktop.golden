=== lefthook.yml 0644 ===
commit-msg:
  commands:
    conventional:
      run: mise run commit-check -- {1}

pre-commit:
  commands:
    fmt:
      run: mise run fmt-check
    lint:
      run: mise run lint

pre-push:
  commands:
    test:
      run: mise run test

=== mise.toml 0644 ===
[settings]
lockfile = false

[tools]
"cocogitto" = "1.2.3"
"java" = "1.2.3"
"lefthook" = "1.2.3"
"lychee" = "1.2.3"
"node" = "1.2.3"
"osv-scanner" = "1.2.3"
"pnpm" = "1.2.3"
"rust" = { version = "1.2.3", components = ["clippy", "rustfmt"], targets = ["aarch64-apple-ios", "aarch64-apple-ios-sim", "aarch64-linux-android", "armv7-linux-androideabi", "i686-linux-android", "x86_64-apple-ios", "x86_64-linux-android"] }
"semgrep" = "1.2.3"
"trufflehog" = "1.2.3"

[tasks."setup"]
description = "依存関係をインストールする"
run = '''
set -e
pnpm install --frozen-lockfile
cargo fetch --locked --manifest-path src-tauri/Cargo.toml
if [ -e .git ]; then lefthook install; fi
'''

[tasks."fmt"]
description = "コードを整形する"
run = '''
set -e
pnpm exec oxfmt --write .
cargo fmt --manifest-path src-tauri/Cargo.toml
'''

[tasks."fmt-check"]
description = "コードが整形済みか確認する"
run = '''
set -e
pnpm exec oxfmt --check .
cargo fmt --manifest-path src-tauri/Cargo.toml -- --check
'''

[tasks."lint"]
description = "静的解析を実行する"
run = '''
set -e
pnpm exec textlint "**/*.md"
pnpm exec markdownlint-cli2
lychee --exclude-path node_modules --exclude-path dist --exclude-path .cache .
pnpm exec oxlint .
pnpm exec knip
cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings
'''

[tasks."typecheck"]
description = "型を検査する"
run = '''
set -e
pnpm exec tsc --noEmit -p tsconfig.json
'''

[tasks."test"]
description = "テストを実行する"
run = '''
set -e
cargo test --manifest-path src-tauri/Cargo.toml
'''

[tasks."security"]
description = "セキュリティ検査を実行する"
run = '''
set -e
osv-scanner scan source -r .
trufflehog filesystem . --fail --no-update
semgrep scan --config auto .
'''

[tasks."build"]
description = "成果物をビルドする"
run = '''
set -e
pnpm exec tauri build
'''

[tasks."commit-check"]
description = "コミットメッセージを検査する"
run = '''
set -e
cog verify --file "$1"
'''

[tasks.check]
description = "全検査を実行する"
depends = ["fmt-check", "lint", "typecheck", "test", "security"]

[tasks."app:dev-web"]
description = "Desktopのフロントエンドを起動する"
run = '''
set -e
pnpm exec vite --port 1420
'''

[tasks."app:build-web"]
description = "Desktopのフロントエンドをビルドする"
run = '''
set -e
pnpm exec vite build
'''

[tasks."app:dev"]
description = "Appを起動する"
run = '''
set -e
pnpm exec tauri dev
'''

[tasks."app:build"]
description = "Appをビルドする"
run = '''
set -e
pnpm exec tauri build
'''

